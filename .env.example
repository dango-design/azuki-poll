# Local dev: leave both blank — falls back to a SQLite file at ./data/poll.db.
# Production (Vercel): set both, get them from your Turso dashboard:
#   turso db create azuki-baby-poll
#   turso db show azuki-baby-poll --url
#   turso db tokens create azuki-baby-poll
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Admin password. Defaults to "azuki" if unset.
ADMIN_PASSWORD=

# Base URL printed by `npm run seed` (so links it prints are clickable).
# Locally: http://localhost:3000   Prod: https://your-app.vercel.app
BASE_URL=
